    "NSUserTrackingUsageDescription" : {
      "comment" : "App Tracking Transparency prompt. Shown after onboarding, never at cold start.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow tracking so we can show you Fielmedina recommendations that match your interests and understand which guides travellers find useful."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le suivi pour recevoir des recommandations Fielmedina adaptées à vos centres d'intérêt et nous aider à savoir quels guides sont les plus utiles aux voyageurs."
          }
        }
      }
    }
